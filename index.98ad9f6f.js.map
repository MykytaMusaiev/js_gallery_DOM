"use strict";
var list = document.getElementById("thumbs");
list.addEventListener("click", function(e) {
    e.preventDefault();
    var listItem = e.target.closest("li");
    if (listItem) {
        var link = listItem.querySelector("a");
        if (link) {
            var newImageUrl = link.href;
            var bigImage = document.getElementById("largeImg");
            bigImage.setAttribute("src", newImageUrl);
        }
    }
});

